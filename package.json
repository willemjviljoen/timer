{
  "name": "timetracker",
  "version": "0.0.7",
  "description": "Minimal time tracking app with system tray support",
  "main": "src/main/main.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "generate-icon": "node scripts/generate-icon.js",
    "start": "electron .",
    "dev": "concurrently \"npx webpack serve --config webpack.config.js\" \"wait-on http://localhost:9000 && electron .\"",
    "build": "npx webpack --config webpack.config.js --mode production",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.timetracker.app",
    "productName": "TimeTracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**/*",
      "dist/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env",
        "filter": [
          ".env"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "overrides": {
    "uuid": "^14.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "firebase": "^12.12.0",
    "pocketbase": "^0.26.8"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "babel-loader": "^10.1.1",
    "concurrently": "^9.1.0",
    "css-loader": "^7.1.2",
    "electron": "^41.2.1",
    "electron-builder": "^26.9.0",
    "html-webpack-plugin": "^5.6.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.34.5",
    "style-loader": "^4.0.0",
    "vitest": "^4.1.4",
    "wait-on": "^9.0.5",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  }
}
